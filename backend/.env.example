# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL
DATABASE_URL=postgresql://portal_user:portal_pass@localhost:5432/portal_db

# JWT Auth
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS (used later, by the Terraform orchestrator — NOT hardcoded credentials)
AWS_REGION=ap-south-1
AWS_PROFILE=portal-project
